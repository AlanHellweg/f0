# f0 additions. The theme follows the macOS appearance and matches the tmux and
# Neovim configs; colors set in your own Ghostty config file override it.
theme = light:Catppuccin Latte,dark:Catppuccin Mocha
font-family = JetBrainsMono Nerd Font
font-size = 14
window-padding-x = 12
window-padding-y = 8
window-padding-balance = true
window-padding-color = extend
macos-option-as-alt = true
window-save-state = always
shell-integration-features = no-cursor

# Panes belong to tmux: Ghostty splits would sit outside the f0 session, and its
# clear would wipe every pane at once. Cmd-k sends the tmux prefix plus Ctrl-l, so it
# clears only the focused pane.
keybind = super+d=ignore
keybind = super+shift+d=ignore
keybind = super+k=text:\x01\x0c
